{
  "name": "parking-occupancy-detector",
  "version": "1.0.0",
  "description": "SENTINEL HMI Parking Occupancy Detector",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.sentinel.parking",
    "productName": "SENTINEL-HMI",
    "win": {
      "target": "portable",
      "icon": "backend/app/static/favicon.ico"
    },
    "files": [
      "main.js",
      "package.json",
      "backend/app/static/**/*",
      "backend/app/templates/**/*"
    ],
    "extraResources": [
      {
        "from": "backend_dist/backend.exe",
        "to": "backend.exe"
      }
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  }
}
